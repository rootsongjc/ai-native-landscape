---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandscapeCategory from './LandscapeCategory.astro';
import LandscapeHeatmap from './LandscapeHeatmap.astro';
import LandscapeMap from './LandscapeMap.astro';
import LandscapeToolbar from './LandscapeToolbar.astro';
import SearchModal from './SearchModal.astro';
import {
  categoryName,
  getLandscape,
  localizedPath,
  projectDescription,
  SITE,
  subCategoryName,
  ui,
} from '../lib/landscape.mjs';

const { lang = 'en' } = Astro.props;
const copy = ui(lang);
const landscape = getLandscape();
const categories = landscape.categories
  .filter((cat) => (landscape.byCategory[cat.key] || []).length > 0)
  .sort((a, b) => (landscape.byCategory[b.key] || []).length - (landscape.byCategory[a.key] || []).length);
const directoryProjectStat = { value: landscape.projectCount, label: copy.projects };
const categoryHighlights = categories.map((category) => {
  const projects = landscape.byCategory[category.key] || [];
  const subcategories = (category.subcategories || [])
    .map((subcategory) => ({
      key: subcategory.key,
      name: subCategoryName(subcategory.key, lang),
      count: (landscape.bySubCategory[subcategory.key] || []).length,
    }))
    .filter((subcategory) => subcategory.count > 0)
    .sort((a, b) => b.count - a.count)
    .slice(0, 4);
  return { category, projects, subcategories };
});

const searchIndex = landscape.projects.map((project) => ({
  slug: project.slug,
  name: project.name,
  repoSlug: project.repoSlug,
  statusKey: project.status,
  categoryKey: project.category,
  subCategoryKey: project.subCategory,
  tags: project.tags || [],
  description: projectDescription(project, lang),
}));
const canonical = localizedPath('/', lang);
---

<BaseLayout title={SITE.title} description={copy.metaDescription} canonical={canonical} lang={lang}>
  <main class="landscape-page" data-landscape-page>
    <section class="landscape-hero" aria-labelledby="landscape-title">
      <div class="landscape-hero__bar">
        <h1 id="landscape-title">{copy.homeHeroHeadline}</h1>
        <div class="landscape-hero__actions">
          <a class="landscape-hero__cta landscape-hero__cta--primary" href={localizedPath('/projects/', lang)}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></svg>
            {copy.homeBrowseProjects}
          </a>
          <a class="landscape-hero__cta" href={localizedPath('/submit/', lang)}>{copy.submitProject}</a>
        </div>
      </div>
    </section>

    <div class="landscape-views" data-home-view="map" data-home-views>
      <script is:inline>
        (function () {
          var params = new URLSearchParams(location.search);
          var view = params.get('display');
          // The heatmap lives in the list view, so old ?view=heatmap links open it.
          if (view !== 'list' && view !== 'map' && params.get('view') === 'heatmap') view = 'list';
          if (view !== 'list' && view !== 'map') {
            try { view = localStorage.getItem('landscape-home-view'); } catch (error) { view = null; }
          }
          if (view === 'list') document.currentScript.parentElement.dataset.homeView = 'list';
        })();
      </script>
      <div class="landscape-viewswitch" role="group" aria-label={copy.homeViewLabel}>
        <button type="button" data-home-view-btn="map" aria-pressed="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="5" rx="1"/><rect x="13" y="10" width="8" height="11" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/></svg>
          {copy.homeViewMap}
        </button>
        <button type="button" data-home-view-btn="list" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          {copy.homeViewList}
        </button>
      </div>

    <LandscapeMap lang={lang} />

    <section class="landscape-categories" id="landscape-categories" aria-labelledby="landscape-categories-title">
      <div class="landscape-section__head">
        <h2 id="landscape-categories-title">{copy.homeCategoryOverviewTitle}</h2>
        <p>{copy.homeCategoryOverviewDescription}</p>
      </div>
      <div class="landscape-category-overview">
        {categoryHighlights.map(({ category, projects, subcategories }, index) => (
          <article class="landscape-category-overview__card">
            <div class="landscape-category-overview__main">
              <span class="landscape-category-overview__index">{String(index + 1).padStart(2, '0')}</span>
              <h3><a href={localizedPath(`/categories/${category.key}/`, lang)}>{categoryName(category, lang)}</a></h3>
              <span>{projects.length} {copy.projects}</span>
            </div>
            <div class="landscape-category-overview__subcats">
              {subcategories.map((subcategory) => (
                <a href={localizedPath(`/categories/${category.key}/?sub=${subcategory.key}`, lang)}>
                  {subcategory.name} <span>{subcategory.count}</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <details class="landscape-directory" id="landscape-directory">
      <summary class="landscape-directory__summary">
        <h2 id="landscape-directory-title">
          <span>{copy.directoryTitle}</span>
          <span class="landscape-directory__meta" aria-label={copy.scopeBoundary}>
            <strong>{directoryProjectStat.value}</strong>
            <small>{directoryProjectStat.label}</small>
          </span>
        </h2>
        <p>{copy.homeDirectorySummary}</p>
      </summary>

      <section class="landscape-search" aria-labelledby="landscape-search-title">
        <div class="landscape-section__head">
          <h2 id="landscape-search-title">{copy.browseFilterTitle}</h2>
          <p>{copy.searchSectionDescription}</p>
        </div>
        <LandscapeToolbar lang={lang} categories={categories} />
      </section>

      <div class="landscape-category-grid" data-landscape-grid>
        {categories.map((cat) => <LandscapeCategory category={cat} lang={lang} />)}
      </div>

      <LandscapeHeatmap lang={lang} />
    </details>
    </div>
  </main>

  <SearchModal searchIndex={searchIndex} lang={lang} />

  <script define:vars={{ searchIndex }}>
    const grid = document.querySelector('[data-landscape-grid]');
    const heatmap = document.querySelector('[data-heatmap]');
    const categorySelect = document.querySelector('[data-landscape-category]');
    const statusSelect = document.querySelector('[data-landscape-status]');
    const sortSelect = document.querySelector('[data-landscape-sort]');

    // Homepage view: landscape map (default) or the list-style directory
    const homeViews = document.querySelector('[data-home-views]');
    const homeViewBtns = document.querySelectorAll('[data-home-view-btn]');
    function syncHomeViewBtns() {
      homeViewBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.homeViewBtn === homeViews.dataset.homeView)));
    }
    homeViewBtns.forEach(b => b.addEventListener('click', () => {
      const view = b.dataset.homeViewBtn;
      homeViews.dataset.homeView = view;
      try { localStorage.setItem('landscape-home-view', view); } catch {}
      const url = new URL(location);
      // A ?view=heatmap link implies the list view, so the map needs an explicit override.
      if (view === 'map' && url.searchParams.get('view') !== 'heatmap') url.searchParams.delete('display');
      else url.searchParams.set('display', view);
      history.replaceState(null, '', url);
      syncHomeViewBtns();
      // Card tooltips are measured on resize; they had no layout while hidden.
      window.dispatchEvent(new Event('resize'));
    }));
    syncHomeViewBtns();

    // View toggle
    const viewBtns = document.querySelectorAll('[data-view]');
    const mobileViewQuery = window.matchMedia('(max-width: 720px)');
    const requestedView = new URLSearchParams(location.search).get('view') || 'grid';
    let currentView = mobileViewQuery.matches ? 'grid' : requestedView;
    function setView(view) {
      if (mobileViewQuery.matches) view = 'grid';
      currentView = view;
      const url = new URL(location);
      if (view === 'grid') url.searchParams.delete('view');
      else url.searchParams.set('view', view);
      history.replaceState(null, '', url);
      const isGrid = view === 'grid';
      grid.style.display = isGrid ? '' : 'none';
      heatmap.style.display = isGrid ? 'none' : '';
      viewBtns.forEach(b => b.classList.toggle('landscape-toolbar__view-btn--active', b.dataset.view === view));
    }
    viewBtns.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));
    mobileViewQuery.addEventListener('change', () => setView(currentView));
    setView(currentView);

    function scoreTier(score) {
      if (!Number.isFinite(score)) return 'loading';
      if (score >= 90) return 'tier90';
      if (score >= 80) return 'tier80';
      if (score >= 70) return 'tier70';
      if (score >= 60) return 'tier60';
      return 'tierBelow';
    }

    function distributeHeatmapChips() {
      if (!window.aiLandscapeScores) return;
      const rows = heatmap.querySelectorAll('.heatmap__row');
      rows.forEach(row => {
        const staging = row.querySelector('[data-staging]');
        if (!staging) return;
        const cells = {};
        row.querySelectorAll('.heatmap__cell').forEach(cell => {
          cells[cell.dataset.tier] = cell;
        });
        const chips = staging.querySelectorAll('.heatmap__chip');
        chips.forEach(chip => {
          const repo = chip.dataset.scoreRepo;
          if (!repo) return;
          const s = window.aiLandscapeScores.getCachedScore(repo);
          const tier = scoreTier(s?.health);
          const target = cells[tier];
          if (target) target.appendChild(chip);
        });
      });
    }

    function getCardScore(card) {
      const repo = card.dataset.scoreRepo;
      if (!repo || !window.aiLandscapeScores) return -1;
      const s = window.aiLandscapeScores.getCachedScore(repo);
      return s?.health ?? -1;
    }

    function sortCardsInGrid(gridEl, mode) {
      if (mode === 'default') return;
      const cards = [...gridEl.children];
      cards.sort((a, b) => {
        if (mode === 'score') return getCardScore(b) - getCardScore(a);
        if (mode === 'name') return (a.dataset.cardName || '').localeCompare(b.dataset.cardName || '');
        if (mode === 'added') return (b.dataset.cardAdded || '').localeCompare(a.dataset.cardAdded || '');
        if (mode === 'oss-date') return (b.dataset.cardOssDate || '').localeCompare(a.dataset.cardOssDate || '');
        return 0;
      });
      cards.forEach(c => gridEl.appendChild(c));
    }

    function filterCategoryContainer(container, category, status, query, sortMode) {
      const sections = container?.querySelectorAll('.landscape-cat') || [];
      const hasActiveFilters = Boolean(query || category !== 'all' || status !== 'all');

      sections.forEach(section => {
        const categoryKey = section.dataset.category || '';
        const subcategories = section.querySelectorAll('.landscape-subcat');
        let visibleCount = 0;

        subcategories.forEach(subcategory => {
          const cards = subcategory.querySelectorAll('.landscape-card');
          const moreButton = subcategory.querySelector('[data-expand-subcategory]');
          const hiddenRest = subcategory.querySelector('[data-subcategory-rest]');
          let visibleSubcategoryCount = 0;

          cards.forEach(card => {
            const name = (card.dataset.cardName || '').toLowerCase();
            const slug = (card.dataset.cardSlug || '').toLowerCase();
            const entry = searchIndex.find(e => e.slug === slug);
            const desc = (entry?.description || '').toLowerCase();
            const repo = card.dataset.scoreRepo;
            const cardStatus = window.aiLandscapeScores?.getProjectStatus?.(repo) || '';

            const matchSearch = !query || name.includes(query) || desc.includes(query) || slug.includes(query);
            const matchCategory = category === 'all' || categoryKey === category;
            const matchStatus = status === 'all' || cardStatus === status;

            if (matchSearch && matchCategory && matchStatus) {
              card.style.display = '';
              visibleSubcategoryCount++;
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (hiddenRest) {
            if (hasActiveFilters) {
              hiddenRest.hidden = false;
            } else {
              hiddenRest.hidden = moreButton?.dataset.expanded !== 'true';
            }
          }

          if (moreButton) {
            moreButton.style.display = hasActiveFilters || visibleSubcategoryCount === 0 ? 'none' : '';
          }

          subcategory.style.display = visibleSubcategoryCount === 0 ? 'none' : '';

          if (sortMode !== 'default') {
            subcategory.querySelectorAll('.landscape-subcat__grid').forEach(g => sortCardsInGrid(g, sortMode));
          }
        });

        section.style.display = visibleCount === 0 ? 'none' : '';
      });
    }

    function applyFilters() {
      const category = categorySelect?.value || 'all';
      const status = statusSelect?.value || 'all';
      const sortMode = sortSelect?.value || 'default';

      filterCategoryContainer(grid, category, status, '', sortMode);

      updateAllTooltipOffsets();
    }

    if (categorySelect) categorySelect.addEventListener('change', applyFilters);
    if (statusSelect) statusSelect.addEventListener('change', applyFilters);
    if (sortSelect) sortSelect.addEventListener('change', applyFilters);

    function updateTooltipOffset(card) {
      const tooltip = card?.querySelector('.landscape-card__tooltip');
      if (!tooltip) return;

      card.style.setProperty('--tooltip-offset', '0px');
      const viewportPadding = 12;

      let offset = 0;
      for (let index = 0; index < 2; index += 1) {
        const rect = tooltip.getBoundingClientRect();

        if (rect.left < viewportPadding) {
          offset += viewportPadding - rect.left;
        } else if (rect.right > window.innerWidth - viewportPadding) {
          offset += window.innerWidth - viewportPadding - rect.right;
        } else {
          break;
        }

        card.style.setProperty('--tooltip-offset', `${Math.round(offset)}px`);
      }

      card.style.setProperty('--tooltip-offset', `${Math.round(offset)}px`);
    }

    function updateAllTooltipOffsets() {
      document.querySelectorAll('.landscape-card').forEach(card => updateTooltipOffset(card));
    }

    updateAllTooltipOffsets();
    window.addEventListener('resize', updateAllTooltipOffsets);

    function hydrateTooltipStatuses() {
      if (!window.aiLandscapeScores) return;
      const cards = document.querySelectorAll('.landscape-card[data-score-repo]');
      cards.forEach(card => {
        const repo = card.dataset.scoreRepo;
        if (!repo) return;
        const scores = window.aiLandscapeScores.getCachedScore(repo);
        const tip = card.querySelector('[data-tooltip-status]');
        if (!tip) return;
        tip.textContent = window.aiLandscapeScores.scoreLabel(scores?.health);
      });
    }

    window.addEventListener('ai-landscape:scores-ready', () => {
      hydrateTooltipStatuses();
      distributeHeatmapChips();
    });
    const scoreCheck = setInterval(() => {
      if (window.aiLandscapeScores?.getCachedScore(searchIndex[0]?.repoSlug)) {
        hydrateTooltipStatuses();
        distributeHeatmapChips();
        clearInterval(scoreCheck);
      }
    }, 500);
    setTimeout(() => clearInterval(scoreCheck), 10000);

  </script>
</BaseLayout>

<style>
  .landscape-page {
    padding: 24px 0 64px;
    display: grid;
    gap: 48px;
  }

  .landscape-views {
    display: grid;
    gap: 48px;
    min-width: 0;
  }

  .landscape-viewswitch {
    justify-self: start;
    display: inline-flex;
    margin-bottom: -28px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .landscape-viewswitch button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .landscape-viewswitch button svg {
    width: 15px;
    height: 15px;
  }

  .landscape-viewswitch button:hover {
    color: var(--text);
  }

  .landscape-viewswitch button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .landscape-views[data-home-view='list'] :global(.lmap),
  .landscape-views[data-home-view='map'] .landscape-categories,
  .landscape-views[data-home-view='map'] .landscape-directory {
    display: none;
  }

  .landscape-hero,
  .landscape-search,
  .landscape-directory {
    display: grid;
    gap: 16px;
  }

  .landscape-section__head {
    display: grid;
    gap: 8px;
    max-width: 720px;
  }

  .landscape-section__head h2 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .landscape-section__head p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .landscape-directory__meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 10px;
    color: var(--muted);
    vertical-align: middle;
  }

  .landscape-directory__heading h2 {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
  }

  .landscape-directory__meta strong {
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .landscape-directory__meta small {
    font-size: 0.7rem;
    font-weight: 500;
  }

  .landscape-category-grid,
  .landscape-grid {
    display: grid;
    gap: 32px;
  }

  @media (max-width: 720px) {
    .landscape-page {
      gap: 40px;
    }
  }

  @media (max-width: 480px) {
    .landscape-page {
      padding: 16px 0 48px;
      gap: 32px;
    }

    .landscape-section__head h2 {
      font-size: 1.45rem;
      letter-spacing: 0;
    }

    .landscape-section__head p {
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .landscape-directory__heading h2 {
      display: flex;
      gap: 8px;
    }

    .landscape-directory__meta {
      margin-left: 0;
    }
  }

  /* Homepage IA redesign */
  .landscape-page {
    gap: 48px;
  }

  .landscape-start,
  .landscape-categories,
  .landscape-directory {
    display: grid;
    gap: 16px;
  }

  .landscape-start__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-block: 1px solid var(--border);
  }

  .landscape-start-card {
    display: grid;
    align-content: start;
    gap: 8px;
    min-height: 144px;
    padding: 20px;
    border: 0;
    border-right: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    text-decoration: none;
    transition: background-color 0.16s;
  }

  .landscape-start-card:last-child {
    border-right: 0;
  }

  .landscape-start-card--button {
    font: inherit;
    cursor: pointer;
  }

  .landscape-start-card:hover,
  .landscape-start-card:focus-visible {
    background: var(--surface-soft);
  }

  .landscape-start-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--muted);
  }

  .landscape-start-card__icon svg {
    width: 18px;
    height: 18px;
  }

  .landscape-start-card strong {
    font-size: 0.98rem;
    line-height: 1.2;
  }

  .landscape-start-card span:not(.landscape-start-card__icon) {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .landscape-start-card small {
    margin-top: auto;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .landscape-category-overview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .landscape-category-overview__card {
    display: grid;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .landscape-category-overview__main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .landscape-category-overview__main h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  .landscape-category-overview__main a {
    color: var(--text);
    text-decoration: none;
  }

  .landscape-category-overview__main a:hover {
    color: var(--accent);
  }

  .landscape-category-overview__main > span {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 500;
  }

  .landscape-category-overview__subcats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .landscape-category-overview__subcats a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 24px;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 400;
    text-decoration: none;
  }

  .landscape-category-overview__subcats a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .landscape-category-overview__subcats span {
    color: var(--muted);
  }

  .landscape-directory {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 0;
  }

  .landscape-directory__summary {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 24px;
    cursor: pointer;
    list-style: none;
  }

  .landscape-directory__summary::-webkit-details-marker {
    display: none;
  }

  .landscape-directory__summary::after {
    content: '+';
    position: absolute;
    right: 24px;
    margin-top: 2px;
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .landscape-directory[open] .landscape-directory__summary::after {
    content: '-';
  }

  .landscape-directory__summary h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding-right: 36px;
    font-size: 1.36rem;
    font-weight: 500;
  }

  .landscape-directory__summary p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .landscape-directory .landscape-search,
  .landscape-directory .landscape-category-grid,
  .landscape-directory :global(.heatmap) {
    margin: 0 24px 24px;
  }

  @media (max-width: 980px) {
    .landscape-start__grid,
    .landscape-category-overview {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .landscape-start-card:nth-child(2) {
      border-right: 0;
    }

    .landscape-start-card:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 720px) {
    .landscape-start__grid,
    .landscape-category-overview {
      grid-template-columns: 1fr;
    }

    .landscape-start-card {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }

    .landscape-start-card:last-child {
      border-bottom: 0;
    }

    .landscape-directory__summary {
      padding: 20px;
    }

    .landscape-directory__summary::after {
