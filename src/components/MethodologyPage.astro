---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, levelLabel, levelsSyncedAt, localizedPath, SITE, ui } from '../lib/landscape.mjs';
import { DIMENSIONS, LEVELS, MAX_POINTS, tierText } from '../lib/levels.mjs';

const { lang = 'en' } = Astro.props;
const copy = ui(lang);
const isZh = lang === 'zh';
const syncedAt = levelsSyncedAt();
const levelCounts = {};
for (const project of getProjects()) levelCounts[project.level] = (levelCounts[project.level] || 0) + 1;
---

<BaseLayout title={copy.methodologyPageTitle} description={copy.methodologyPageDescription} canonical={localizedPath('/methodology/', lang)} lang={lang}>
  <main class="methodology-page">
    <section class="method-hero">
      <h1>{copy.methodologyPageTitle}</h1>
      <p>{copy.methodologyPageDescription}</p>
    </section>

    <!-- Scoring Model -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
        {copy.scoringModel}
      </h2>
      <p class="method-section__intro">{copy.scoringModelDescription}</p>
      <div class="method-dims">
        <article class="method-dim">
          <div class="method-dim__header">
            <span class="method-dim__icon">A</span>
            <h3>{copy.activity}</h3>
          </div>
          <p>{copy.activityDescription}</p>
        </article>
        <article class="method-dim">
          <div class="method-dim__header">
            <span class="method-dim__icon">C</span>
            <h3>{copy.community}</h3>
          </div>
          <p>{copy.communityDescription}</p>
        </article>
        <article class="method-dim">
          <div class="method-dim__header">
            <span class="method-dim__icon">Q</span>
            <h3>{copy.quality}</h3>
          </div>
          <p>{copy.qualityDescription}</p>
        </article>
        <article class="method-dim">
          <div class="method-dim__header">
            <span class="method-dim__icon">S</span>
            <h3>{copy.sustainability}</h3>
          </div>
          <p>{copy.sustainabilityDescription}</p>
        </article>
      </div>
    </section>

    <!-- Score Labels -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        {copy.scoringRange}
      </h2>
      <div class="method-labels">
        <div class="method-label">
          <span class="method-label__badge" data-score-level="90">≥90</span>
          <div>
            <strong>{copy.scoreRange90}</strong>
            <p>{copy.scoreRange90Desc}</p>
          </div>
        </div>
        <div class="method-label">
          <span class="method-label__badge" data-score-level="80">≥80</span>
          <div>
            <strong>{copy.scoreRange80}</strong>
            <p>{copy.scoreRange80Desc}</p>
          </div>
        </div>
        <div class="method-label">
          <span class="method-label__badge" data-score-level="70">≥70</span>
          <div>
            <strong>{copy.scoreRange70}</strong>
            <p>{copy.scoreRange70Desc}</p>
          </div>
        </div>
        <div class="method-label">
          <span class="method-label__badge" data-score-level="60">≥60</span>
          <div>
            <strong>{copy.scoreRange60}</strong>
            <p>{copy.scoreRange60Desc}</p>
          </div>
        </div>
        <div class="method-label">
          <span class="method-label__badge" data-score-level="0">&lt;60</span>
          <div>
            <strong>{copy.scoreRangeBelow}</strong>
            <p>{copy.scoreRangeBelowDesc}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Curation Standards -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {copy.curationStandards}
      </h2>
      <p class="method-section__intro">{copy.curationStandardsDescription}</p>
      <ul class="method-rules">
        <li>{copy.curationRule1}</li>
        <li>{copy.curationRule2}</li>
        <li>{copy.curationRule3}</li>
        <li>{copy.curationRule4}</li>
        <li>{copy.curationRule5}</li>
        <li>{copy.curationRule6}</li>
      </ul>
      <p class="method-section__intro">{copy.curationNote}</p>
    </section>

    <!-- Project levels -->
    <section class="method-section" id="project-levels">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 20h4v-6H3zM10 20h4V9h-4zM17 20h4V4h-4z"/></svg>
        {copy.projectLevels}
      </h2>
      <p class="method-section__intro">{copy.projectLevelsDescription}</p>

      <h3 class="method-section__subhead">{copy.levelDimensionsTitle}</h3>
      <p class="method-section__intro">{copy.levelDimensionsDescription.replace('{count}', DIMENSIONS.length).replace('{max}', MAX_POINTS)}</p>
      <div class="method-table-wrap">
        <table class="method-table">
          <thead>
            <tr>
              <th scope="col">{copy.levelDimension}</th>
              <th scope="col">{copy.levelScoring}</th>
            </tr>
          </thead>
          <tbody>
            {DIMENSIONS.map((dimension) => (
              <tr>
                <th scope="row">
                  <strong>{copy.levelDimensions[dimension.key].name}</strong>
                  <span>{copy.levelDimensions[dimension.key].description}</span>
                </th>
                <td>
                  <ul class="method-tiers">
                    {dimension.tiers.map((tier) => (
                      <li>
                        <span class="method-tiers__points">{copy.levelPointsLabel.replace('{points}', tier.points)}</span>
                        {tierText(dimension.key, tier.points, lang)}
                      </li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="method-section__subhead">{copy.levelRulesTitle}</h3>
      <div class="method-lifecycle">
        {LEVELS.map((level) => (
          <article class="method-status" data-level={level.key}>
            <span class="method-status__badge">
              <span class={`status-dot status-dot--${level.key}`} />
              {levelLabel(level.key, lang)}
              <small>{levelCounts[level.key] || 0}</small>
            </span>
            <p class="method-status__rule">
              {copy.levelRule[level.key]
                .replace('{min}', level.minPoints)
                .replace('{max}', MAX_POINTS)
                .replace('{required}', Object.entries(level.required)
                  .map(([key, points]) => copy.levelRequiredPoints.replace('{dimension}', copy.levelDimensions[key].name).replace('{points}', points))
                  .join(isZh ? '、' : ' and '))}
            </p>
            <p>{copy.levelDescriptions[level.key]}</p>
          </article>
        ))}
      </div>

      <h3 class="method-section__subhead">{copy.levelNotesTitle}</h3>
      <ul class="method-rules">
        <li>{copy.levelNote1}</li>
        <li>{copy.levelNote2}</li>
        <li>{copy.levelNote3}</li>
      </ul>
      {syncedAt && <p class="method-section__intro">{copy.levelSyncedAt.replace('{date}', syncedAt)}</p>}
    </section>

    <!-- How to Submit -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        {copy.howToSubmit}
      </h2>
      <p class="method-section__intro">{copy.howToSubmitDescription}</p>
      <ol class="method-steps">
        <li>{copy.submitStep1}</li>
        <li>{copy.submitStep2}</li>
        <li>{copy.submitStep3}</li>
      </ol>
      <a class="method-cta" href={SITE.issueNew} target="_blank" rel="noopener noreferrer">
        {copy.openIssueForm}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
      </a>
    </section>

    <!-- How to Update -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        {copy.howToUpdate}
      </h2>
      <p class="method-section__intro">{copy.howToUpdateDescription}</p>
      <ol class="method-steps">
        <li>{copy.updateStep1}</li>
        <li>{copy.updateStep2}</li>
        <li>{copy.updateStep3}</li>
      </ol>
    </section>

    <!-- How projects are removed -->
    <section class="method-section">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/></svg>
        {copy.howToRemove}
      </h2>
      <p class="method-section__intro">{copy.howToRemoveDescription}</p>
      <ul class="method-rules">
        <li>{copy.removeReason1}</li>
        <li>{copy.removeReason2}</li>
        <li>{copy.removeReason3}</li>
        <li>{copy.removeReason4}</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .methodology-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }

  /* Hero */
  .method-hero {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .method-hero h1 {
    font-size: 2.25rem;
    font-weight: 500;
    margin: 0 0 8px;
  }
  .method-hero p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Sections */
  .method-section {
    margin-bottom: 36px;
  }
  .method-section h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--text);
  }
  .method-section h2 svg {
    color: var(--muted);
    flex-shrink: 0;
  }
  .method-section__intro {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 16px;
    line-height: 1.5;
  }

  /* Scoring Dimensions */
  .method-dims {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .method-dim {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .method-dim__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .method-dim__icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: var(--muted);
    background: var(--surface-soft);
    font-weight: 600;
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  .method-dim h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0;
  }
  .method-dim p {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.45;
    margin: 0;
  }

  /* Score Labels */
  .method-labels {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .method-label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .method-label__badge {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 32px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface-soft);
    flex-shrink: 0;
  }
  .method-label strong {
    font-size: 0.88rem;
    display: block;
    margin-bottom: 2px;
  }
  .method-label p {
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.35;
  }

  /* Rules / Steps */
  .method-rules, .method-steps {
    padding-left: 20px;
    margin: 0;
  }
  .method-rules li, .method-steps li {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 8px;
  }
  .method-rules li::marker {
    color: var(--accent);
  }
  .method-steps li::marker {
    color: var(--accent);
    font-weight: 600;
  }

  /* Lifecycle */
  .method-lifecycle {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .method-status {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .method-status__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }
  .method-status p {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }
  .method-status__badge small {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
  }
  .method-status .method-status__rule {
    margin-bottom: 6px;
    color: var(--text);
    font-weight: 600;
  }
  .method-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .method-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .method-table th,
  .method-table td {
    padding: 10px 12px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }
  .method-table tbody tr:last-child th,
  .method-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .method-table thead th {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }
  .method-tiers {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
  }
  .method-tiers li {
    display: flex;
    gap: 10px;
  }
  .method-tiers__points {
    flex-shrink: 0;
    min-width: 3em;
    color: var(--text);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .method-table tbody th {
    width: 34%;
    font-weight: 400;
  }
  .method-table tbody th strong {
    display: block;
    color: var(--text);
    font-weight: 600;
  }
  .method-section__subhead {
    margin: 20px 0 8px;
    font-size: 0.95rem;
  }

  /* CTA Button */
  .method-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    margin-top: 16px;
    transition: opacity 0.2s;
  }
  .method-cta:hover {
    opacity: 0.9;
  }
  .method-cta svg {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .method-dims, .method-lifecycle {
      grid-template-columns: 1fr;
    }
    .method-hero h1 {
      font-size: 1.8rem;
    }
  }
</style>
